{
  "extends": "astro/tsconfigs/strict",
  "include": [".astro/types.d.ts", "**/*"],
  "exclude": ["dist"],
  "compilerOptions": {
    "jsx": "react-jsx",
    "jsxImportSource": "react",
    "baseUrl": ".",
    "paths": {
      "@/*": ["./src/*"]
    },
    "target": "es2022",
    "lib": ["es2022", "dom", "dom.iterable"],
    "module": "es2020",
    "moduleResolution": "bundler",
    "esModuleInterop": true
  }
}
