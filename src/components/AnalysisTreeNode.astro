---
import type { AnalysisTreeNode } from "@/lib/analyses-tree";

interface Props {
  node: AnalysisTreeNode;
  depth: number;
}

const { node, depth } = Astro.props;

const hasChildren = node.children.length > 0;
// Each level indents by 1.25rem; cap visual indentation at depth 5.
const indentStyle = depth > 0 && depth <= 5 ? "margin-left: 1.25rem" : undefined;
---

{
  hasChildren ? (
    <details
      class="rounded-lg border border-white/10 bg-white/5 transition-colors hover:border-purple-400/40"
      style={indentStyle}
    >
      <summary
        class="cursor-pointer list-none p-4 hover:bg-white/5 [&::-webkit-details-marker]:hidden"
        onclick={`event.preventDefault(); if (event.target.closest('.chevron-area')) { this.closest('details').toggleAttribute('open'); } else { window.location.href = '/analyses/${node.id}'; }`}
      >
        <div class="flex items-start gap-3">
          <div class="chevron-area -m-1 shrink-0 rounded p-1 text-slate-400 hover:text-white">
            <svg
              class="chevron mt-0.5 h-4 w-4"
              fill="none"
              viewBox="0 0 24 24"
              stroke="currentColor"
              stroke-width="2"
              aria-hidden="true"
            >
              <path stroke-linecap="round" stroke-linejoin="round" d="M9 5l7 7-7 7" />
            </svg>
          </div>
          <div class="min-w-0 flex-1">
            <div class="text-base font-medium text-white">{node.title}</div>
            <div class="mt-1.5 flex items-center gap-3 text-xs text-slate-400">
              <span>
                {node.provider} / {node.model}
              </span>
              <span>·</span>
              <span>{new Date(node.created_at).toLocaleDateString("pl-PL")}</span>
            </div>
          </div>
        </div>
      </summary>
      <div class="space-y-2 border-t border-white/10 py-2">
        {node.children.map((child) => (
          <Astro.self node={child} depth={depth + 1} />
        ))}
      </div>
    </details>
  ) : (
    <a
      href={`/analyses/${node.id}`}
      class="block rounded-lg border border-white/10 bg-white/5 p-4 transition-colors hover:border-purple-400/40 hover:bg-white/10"
      style={indentStyle}
    >
      <span class="text-base font-medium text-white">{node.title}</span>
      <div class="mt-1.5 flex items-center gap-3 text-xs text-slate-400">
        <span>
          {node.provider} / {node.model}
        </span>
        <span>·</span>
        <span>{new Date(node.created_at).toLocaleDateString("pl-PL")}</span>
      </div>
    </a>
  )
}

<style>
  .chevron {
    transition: transform 150ms ease;
  }
  /* eslint-disable-next-line astro/no-unused-css-selector -- [open] is a runtime attribute, not statically analysable */
  details[open] > summary .chevron {
    transform: rotate(90deg);
  }
</style>
