---
import type { AnalysisTreeNode } from "@/lib/analyses-tree";

interface Props {
  node: AnalysisTreeNode;
  depth: number;
}

const { node, depth } = Astro.props;

const hasChildren = node.children.length > 0;
// Indent visually by depth; cap to avoid runaway nesting.
const cappedDepth = Math.min(depth, 5);
const indentRem = cappedDepth * 1.5;
---

{
  hasChildren ? (
    <details class="group/node" style={`--node-indent: ${indentRem}rem`} open={depth === 0}>
      <summary
        class="grid cursor-pointer list-none grid-cols-[auto_1fr_auto] items-center gap-3 px-2 py-3.5 transition-colors hover:bg-[color-mix(in_oklch,var(--foreground)_3%,transparent)] [&::-webkit-details-marker]:hidden"
        style="padding-left: calc(var(--node-indent) + 0.5rem)"
        onclick={`event.preventDefault(); if (event.target.closest('.chevron-area')) { this.closest('details').toggleAttribute('open'); } else { window.location.href = '/analyses/${node.id}'; }`}
      >
        <span
          class="chevron-area text-muted-foreground hover:text-foreground -m-1 inline-flex h-6 w-6 shrink-0 items-center justify-center rounded-sm p-1 transition-colors"
          aria-label="Toggle thread"
        >
          <svg
            class="chevron h-3.5 w-3.5"
            fill="none"
            viewBox="0 0 24 24"
            stroke="currentColor"
            stroke-width="2"
            aria-hidden="true"
          >
            <path stroke-linecap="round" stroke-linejoin="round" d="M9 5l7 7-7 7" />
          </svg>
        </span>
        <div class="min-w-0">
          <div class="truncate text-[0.95rem] leading-snug font-medium">{node.title}</div>
          <div class="num text-muted-foreground mt-1 flex flex-wrap items-center gap-x-3 gap-y-0.5 text-xs">
            <span>
              {node.provider} / {node.model}
            </span>
            <span aria-hidden="true">·</span>
            <span>
              {new Date(node.created_at).toLocaleDateString("en-GB", {
                day: "2-digit",
                month: "short",
                year: "numeric",
              })}
            </span>
            <span aria-hidden="true">·</span>
            <span class="text-muted-foreground/80">
              {node.children.length} {node.children.length === 1 ? " continuation" : " continuations"}
            </span>
            {node.company_name && (
              <>
                <span aria-hidden="true">·</span>
                <span>{node.company_name}</span>
              </>
            )}
          </div>
        </div>
        <span class="text-muted-foreground group-hover/node:text-foreground shrink-0 text-xs transition-colors">→</span>
      </summary>
      <div class="border-border/60 ml-[calc(var(--node-indent)+0.75rem)] border-l">
        {node.children.map((child) => (
          <Astro.self node={child} depth={depth + 1} />
        ))}
      </div>
    </details>
  ) : (
    <a
      href={`/analyses/${node.id}`}
      class="group/node grid grid-cols-[auto_1fr_auto] items-center gap-3 px-2 py-3.5 transition-colors hover:bg-[color-mix(in_oklch,var(--foreground)_3%,transparent)]"
      style={`padding-left: ${(cappedDepth * 1.5 + 0.5).toString()}rem`}
    >
      <span class="bg-muted-foreground/50 inline-block h-1 w-1 shrink-0 rounded-full" aria-hidden="true" />
      <div class="min-w-0">
        <div class="truncate text-[0.95rem] leading-snug font-medium">{node.title}</div>
        <div class="num text-muted-foreground mt-1 flex flex-wrap items-center gap-x-3 gap-y-0.5 text-xs">
          <span>
            {node.provider} / {node.model}
          </span>
          <span aria-hidden="true">·</span>
          <span>
            {new Date(node.created_at).toLocaleDateString("en-GB", { day: "2-digit", month: "short", year: "numeric" })}
          </span>
          {node.company_name && (
            <>
              <span aria-hidden="true">·</span>
              <span>{node.company_name}</span>
            </>
          )}
        </div>
      </div>
      <span class="text-muted-foreground group-hover/node:text-foreground shrink-0 text-xs transition-colors">→</span>
    </a>
  )
}

<style>
  .chevron {
    transition: transform 200ms cubic-bezier(0.2, 0.7, 0.2, 1);
  }
  /* eslint-disable-next-line astro/no-unused-css-selector -- [open] is a runtime attribute, not statically analysable */
  details[open] > summary .chevron {
    transform: rotate(90deg);
  }
</style>
