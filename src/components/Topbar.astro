---
const { user } = Astro.locals;
const path = Astro.url.pathname;

function isActive(href: string) {
  if (href === "/dashboard") return path === "/dashboard";
  return path === href || path.startsWith(href + "/");
}

const nav = [
  { href: "/dashboard", label: "Dashboard" },
  { href: "/analyses", label: "Research" },
  { href: "/prompts", label: "Prompts" },
  { href: "/settings", label: "Settings" },
];
---

<header class="border-border/60 bg-background/85 sticky top-0 z-40 w-full border-b backdrop-blur-md">
  <div class="mx-auto flex w-full max-w-6xl items-center justify-between gap-6 px-6 sm:px-10">
    <a href={user ? "/dashboard" : "/"} class="group flex items-center gap-2.5 py-4" aria-label="Quant — home">
      <span
        class="bg-primary text-primary-foreground font-display inline-flex h-7 w-7 items-center justify-center text-base font-semibold"
        aria-hidden="true">Q</span
      >
      <span class="font-display text-lg leading-none tracking-tight">
        Quant<span class="text-muted-foreground font-sans text-xs font-normal tracking-[0.18em] uppercase">
          /research</span
        >
      </span>
    </a>

    {
      user ? (
        <nav class="hidden items-center gap-1 md:flex" aria-label="Primary">
          {nav.map((item) => (
            <a
              href={item.href}
              class:list={[
                "relative px-3 py-1.5 text-sm transition-colors",
                isActive(item.href) ? "text-foreground" : "text-muted-foreground hover:text-foreground",
              ]}
              aria-current={isActive(item.href) ? "page" : undefined}
            >
              {item.label}
              {isActive(item.href) && (
                <span class="bg-primary absolute right-3 -bottom-px left-3 h-px" aria-hidden="true" />
              )}
            </a>
          ))}
        </nav>
      ) : null
    }

    <div class="flex items-center gap-3">
      {
        user ? (
          <>
            <a
              href="/analyses/new"
              class="bg-primary text-primary-foreground hover:bg-primary/80 active:bg-primary/70 hidden items-center gap-2 px-3 py-1.5 text-xs font-medium tracking-[0.08em] transition-colors sm:inline-flex"
            >
              + New analysis
            </a>
            <div class="text-muted-foreground hidden items-center gap-2 text-xs sm:flex">
              <span class="bg-positive inline-block h-1.5 w-1.5 rounded-full" aria-hidden="true" />
              <span class="max-w-[180px] truncate font-mono">{user.email}</span>
            </div>
            <form method="POST" action="/api/auth/signout">
              <button
                type="submit"
                class="text-muted-foreground hover:text-foreground py-1.5 text-xs underline-offset-2 transition-colors hover:underline"
              >
                Sign out
              </button>
            </form>
          </>
        ) : (
          <>
            <a href="/auth/signin" class="text-muted-foreground hover:text-foreground text-sm transition-colors">
              Sign in
            </a>
            <a
              href="/auth/signup"
              class="bg-primary text-primary-foreground hover:bg-prhmary/80 iover:bg-primary/80 inline-flex items-center px-3 py-1.5 text-xs font-medium tracking-[0.08e"
            >
              Open account
            </a>
          </>
        )
      }
    </div>
  </div>

  {/* Mobile nav strip — appears below header for authenticated users on small screens */}
  {
    user && (
      <nav
        class="border-border/60 mx-auto flex w-full max-w-6xl items-center gap-1 overflow-x-auto border-t px-4 py-2 text-xs sm:px-10 md:hidden"
        aria-label="Primary (mobile)"
      >
        {nav.map((item) => (
          <a
            href={item.href}
            class:list={[
              "shrink-0 rounded-sm px-2.5 py-1 transition-colors",
              isActive(item.href)
               
               
                ? "bg-primary text-primary-foreground"
                : "text-muted-foreground hover:text-foreground",
            ]}
            aria-current={isActive(item.href) ? "page" : undefined}
          >
            {item.label}
          </a>
        ))}
      </nav>
    )
  }
</header>
