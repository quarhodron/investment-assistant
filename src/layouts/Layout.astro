---
import "../styles/global.css";
import Banner from "@/components/Banner.astro";
import Topbar from "@/components/Topbar.astro";
import { missingConfigs } from "@/lib/config-status";

interface Props {
  title?: string;
  /** When true, page provides its own full-bleed background and no chrome padding is applied. */
  bare?: boolean;
}

const { title = "Quant — Investing assistant", bare = false } = Astro.props;
const fullTitle = title === "Quant — Investing assistant" ? title : `${title} — Quant`;
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="color-scheme" content="light dark" />
    <link rel="icon" type="image/png" href="/favicon.png" />

    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      rel="stylesheet"
      href="https://fonts.googleapis.com/css2?family=Fraunces:ital,opsz,wght,SOFT@0,9..144,300..700,0..100;1,9..144,300..700,0..100&family=Geist:wght@300..700&family=JetBrains+Mono:wght@400;500;600&display=swap"
    />

    <title>{fullTitle}</title>
  </head>
  <body class="bg-background text-foreground min-h-screen antialiased">
    {
      missingConfigs.map((cfg) => (
        <Banner variant="error">
          <strong class="font-medium">Attention:</strong> {cfg.message}
          {cfg.docsUrl && (
            <>
              {" "}
              <a href={cfg.docsUrl} target="_blank" rel="noopener noreferrer" class="underline underline-offset-2">
                {cfg.docsLabel ?? "Docs"}
              </a>
              .
            </>
          )}
        </Banner>
      ))
    }

    <Topbar />

    {
      bare ? (
        <slot />
      ) : (
        <main class="mx-auto w-full max-w-6xl px-6 py-10 sm:px-10 sm:py-14">
          <slot />
        </main>
      )
    }

    <footer class="border-border/60 mt-24 border-t">
      <div
        class="mx-auto flex w-full max-w-6xl flex-col gap-6 px-6 py-10 sm:flex-row sm:items-center sm:justify-between sm:px-10"
      >
        <div class="flex items-center gap-3">
          <span class="font-display text-lg leading-none">
            Q<span class="italic">uant</span>
          </span>
          <span class="text-muted-foreground/80 text-xs"> Editorial research, terminal precision. </span>
        </div>
        <p class="text-muted-foreground/80 max-w-md text-xs leading-relaxed">
          Quant is an AI research assistant. Output is for informational purposes only and does not constitute
          investment advice. Verify before acting.
        </p>
      </div>
    </footer>

    <script>
      const u = new URL(location.href);
      if (u.searchParams.has("ok") || u.searchParams.has("error")) {
        u.searchParams.delete("ok");
        u.searchParams.delete("error");
        history.replaceState(null, "", u.toString());
      }
    </script>
  </body>
</html>

<style is:global>
  html,
  body {
    margin: 0;
    width: 100%;
  }
  body {
    min-height: 100vh;
    /* Faint paper grain — printed-page texture without going maximalist */
    background-image: radial-gradient(color-mix(in oklch, var(--foreground) 4%, transparent) 0.6px, transparent 0.6px);
    background-size: 3px 3px;
    background-attachment: fixed;
  }
</style>
