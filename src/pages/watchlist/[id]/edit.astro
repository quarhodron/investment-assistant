---
import Layout from "@/layouts/Layout.astro";
import { createClient } from "@/lib/supabase";
import type { WatchedCompany } from "@/types";

const { user } = Astro.locals;
const supabase = createClient(Astro.request.headers, Astro.cookies);
const { id } = Astro.params;

if (!user) {
  return Astro.redirect("/auth/signin");
}
if (!supabase || !id) {
  return Astro.redirect("/watchlist");
}

const { data: company } = await supabase
  .from("watched_companies")
  .select("id, name, ticker, exchange, industry, note")
  .eq("id", id)
  .eq("user_id", user.id)
  .single();

if (!company) {
  return Astro.redirect("/watchlist");
}

const { count: tiedCount } = await supabase
  .from("analyses")
  .select("id", { count: "exact", head: true })
  .eq("user_id", user.id)
  .eq("company_id", id);

const tied = tiedCount ?? 0;

const error = Astro.url.searchParams.get("error");
const ok = Astro.url.searchParams.get("ok");

// On error redirects the API echoes back submitted values as _* params so the
// form shows what the user typed rather than the last-saved DB values.
const hasFormValues = Astro.url.searchParams.has("_name");
type CompanyRow = Pick<WatchedCompany, "id" | "name" | "ticker" | "exchange" | "industry" | "note">;
const c = company as CompanyRow;

const formName = hasFormValues ? (Astro.url.searchParams.get("_name") ?? c.name) : c.name;
const formTicker = hasFormValues ? (Astro.url.searchParams.get("_ticker") ?? c.ticker ?? "") : (c.ticker ?? "");
const formExchange = hasFormValues ? (Astro.url.searchParams.get("_exchange") ?? c.exchange ?? "") : (c.exchange ?? "");
const formIndustry = hasFormValues ? (Astro.url.searchParams.get("_industry") ?? c.industry ?? "") : (c.industry ?? "");
const formNote = hasFormValues ? (Astro.url.searchParams.get("_note") ?? c.note ?? "") : (c.note ?? "");
---

<Layout title="Edit company">
  <div class="mx-auto max-w-3xl">
    <a
      href="/watchlist"
      class="text-muted-foreground hover:text-foreground mb-6 inline-flex items-center gap-2 text-xs transition-colors"
    >
      <span aria-hidden="true">←</span>
      All companies
    </a>

    <header class="border-border/70 mb-10 border-b pb-6">
      <p class="eyebrow mb-3">Edit · watched company</p>
      <h1 class="font-display text-4xl leading-[1.05] tracking-tight text-balance sm:text-5xl">
        {c.name}
      </h1>
    </header>

    {
      error && (
        <div class="text-destructive border-destructive/40 mb-6 flex items-baseline gap-3 border-l-2 bg-[color-mix(in_oklch,var(--destructive)_8%,transparent)] px-3 py-2.5 text-sm">
          <span class="text-xs font-medium tracking-[0.14em] uppercase">Error</span>
          <span>{error}</span>
        </div>
      )
    }

    {
      ok && (
        <div class="text-positive border-positive/40 mb-6 flex items-baseline gap-3 border-l-2 bg-[color-mix(in_oklch,var(--positive)_8%,transparent)] px-3 py-2.5 text-sm">
          <span class="text-xs font-medium tracking-[0.14em] uppercase">Saved</span>
          <span>Company saved.</span>
        </div>
      )
    }

    <div class="border-border/70 bg-card border p-6 sm:p-8">
      <form method="POST" action={`/api/watchlist/${id}`} class="space-y-5">
        <div>
          <label for="name" class="text-muted-foreground mb-1.5 block text-xs font-medium tracking-[0.16em] uppercase">
            Name <span class="text-destructive ml-1 tracking-normal normal-case">*</span>
          </label>
          <input
            type="text"
            id="name"
            name="name"
            required
            maxlength="200"
            value={formName}
            class="border-border bg-background text-foreground focus:border-foreground focus:ring-ring/40 block w-full border px-3 py-2.5 text-sm transition-colors focus:ring-2 focus:outline-none"
          />
        </div>

        <div class="grid grid-cols-2 gap-4">
          <div>
            <label
              for="ticker"
              class="text-muted-foreground mb-1.5 block text-xs font-medium tracking-[0.16em] uppercase"
            >
              Ticker <span class="text-muted-foreground/60 ml-1 tracking-normal normal-case">(optional)</span>
            </label>
            <input
              type="text"
              id="ticker"
              name="ticker"
              maxlength="20"
              value={formTicker}
              class="border-border bg-background text-foreground focus:border-foreground focus:ring-ring/40 block w-full border px-3 py-2.5 text-sm transition-colors focus:ring-2 focus:outline-none"
            />
          </div>
          <div>
            <label
              for="exchange"
              class="text-muted-foreground mb-1.5 block text-xs font-medium tracking-[0.16em] uppercase"
            >
              Exchange <span class="text-muted-foreground/60 ml-1 tracking-normal normal-case">(optional)</span>
            </label>
            <input
              type="text"
              id="exchange"
              name="exchange"
              maxlength="50"
              value={formExchange}
              class="border-border bg-background text-foreground focus:border-foreground focus:ring-ring/40 block w-full border px-3 py-2.5 text-sm transition-colors focus:ring-2 focus:outline-none"
            />
          </div>
        </div>

        <div>
          <label
            for="industry"
            class="text-muted-foreground mb-1.5 block text-xs font-medium tracking-[0.16em] uppercase"
          >
            Industry <span class="text-muted-foreground/60 ml-1 tracking-normal normal-case">(optional)</span>
          </label>
          <input
            type="text"
            id="industry"
            name="industry"
            maxlength="200"
            value={formIndustry}
            class="border-border bg-background text-foreground focus:border-foreground focus:ring-ring/40 block w-full border px-3 py-2.5 text-sm transition-colors focus:ring-2 focus:outline-none"
          />
        </div>

        <div>
          <label for="note" class="text-muted-foreground mb-1.5 block text-xs font-medium tracking-[0.16em] uppercase">
            Note <span class="text-muted-foreground/60 ml-1 tracking-normal normal-case">(optional)</span>
          </label>
          <textarea
            id="note"
            name="note"
            maxlength="2000"
            rows={4}
            class="border-border bg-background text-foreground focus:border-foreground focus:ring-ring/40 block w-full border px-3 py-2.5 text-sm leading-relaxed transition-colors focus:ring-2 focus:outline-none"
            >{formNote}</textarea
          >
        </div>

        <div class="border-border/60 flex items-center gap-4 border-t pt-5">
          <button
            type="submit"
            class="bg-primary text-primary-foreground hover:bg-primary/80 active:bg-primary/70 inline-flex cursor-pointer items-center gap-3 px-5 py-2.5 text-sm font-medium"
          >
            Save changes
          </button>
          <a href="/watchlist" class="text-muted-foreground hover:text-foreground text-sm transition-colors">
            Cancel
          </a>
        </div>
      </form>
    </div>

    <!-- Delete section -->
    <div class="border-border/70 mt-8 border-t pt-8">
      <h2 class="font-display mb-4 text-xl tracking-tight">Danger zone</h2>
      <div data-delete-initial>
        <button
          type="button"
          data-confirm-delete
          class="text-destructive/80 hover:text-destructive cursor-pointer text-sm underline-offset-2 hover:underline"
        >
          Delete this company
        </button>
      </div>
      <div data-delete-confirm hidden>
        <p class="text-muted-foreground mb-4 text-sm">
          This will unlink <strong class="text-foreground">{tied} {tied === 1 ? "analysis" : "analyses"}</strong> but they
          will be preserved. This action cannot be undone.
        </p>
        <form method="POST" action={`/api/watchlist/${id}`} class="flex items-center gap-3">
          <input type="hidden" name="action" value="delete" />
          <button
            type="submit"
            class="text-destructive border-destructive/60 hover:bg-destructive hover:text-background cursor-pointer border-x px-2 py-1 text-xs font-medium transition-colors"
          >
            Confirm delete
          </button>
          <button
            type="button"
            data-delete-cancel
            class="text-muted-foreground hover:text-foreground cursor-pointer text-xs"
          >
            Cancel
          </button>
        </form>
      </div>
    </div>
  </div>
</Layout>

<script>
  const initial = document.querySelector("[data-delete-initial]");
  const confirm = document.querySelector("[data-delete-confirm]");
  document.querySelector("[data-confirm-delete]")?.addEventListener("click", () => {
    initial?.setAttribute("hidden", "");
    confirm?.removeAttribute("hidden");
  });
  document.querySelector("[data-delete-cancel]")?.addEventListener("click", () => {
    confirm?.setAttribute("hidden", "");
    initial?.removeAttribute("hidden");
  });
</script>
