---
import Layout from "@/layouts/Layout.astro";
import { createClient } from "@/lib/supabase";
import type { Prompt } from "@/types";

const { user } = Astro.locals;
const supabase = createClient(Astro.request.headers, Astro.cookies);
const { id } = Astro.params;

if (!supabase || !user || !id) {
  return Astro.redirect("/prompts");
}

const { data: prompt } = await supabase
  .from("prompts")
  .select("id, name, description, body")
  .eq("id", id)
  .eq("user_id", user.id)
  .single();

if (!prompt) {
  return Astro.redirect("/prompts");
}

const error = Astro.url.searchParams.get("error");
const ok = Astro.url.searchParams.get("ok");
---

<Layout title="Edit prompt">
  <div class="bg-cosmic min-h-screen p-6">
    <div class="mx-auto max-w-2xl">
      <h1 class="mb-6 bg-gradient-to-r from-blue-200 to-purple-200 bg-clip-text text-2xl font-bold text-transparent">
        Edit prompt
      </h1>

      {
        error && (
          <div class="mb-4 rounded-lg border border-red-400/30 bg-red-500/10 p-3 text-sm text-red-200">
            {decodeURIComponent(error)}
          </div>
        )
      }

      {
        ok && (
          <div class="mb-4 rounded-lg border border-green-400/30 bg-green-500/10 p-3 text-sm text-green-200">
            Prompt saved.
          </div>
        )
      }

      <div class="rounded-lg border border-white/10 bg-white/5 p-6">
        <form method="POST" action={`/api/prompts/${id}`} class="space-y-4">
          <div>
            <label for="name" class="mb-1 block text-sm font-medium text-white/70"
              >Name <span class="text-red-400">*</span></label
            >
            <input
              type="text"
              id="name"
              name="name"
              required
              maxlength="200"
              value={prompt.name}
              class="w-full rounded-md border border-white/20 bg-white/10 px-3 py-2 text-sm text-white placeholder-white/30 focus:border-purple-400 focus:outline-none"
            />
          </div>

          <div>
            <label for="description" class="mb-1 block text-sm font-medium text-white/70"
              >Description <span class="text-white/40">(optional)</span></label
            >
            <input
              type="text"
              id="description"
              name="description"
              maxlength="500"
              value={prompt.description ?? ""}
              class="w-full rounded-md border border-white/20 bg-white/10 px-3 py-2 text-sm text-white placeholder-white/30 focus:border-purple-400 focus:outline-none"
            />
          </div>

          <div>
            <label for="body" class="mb-1 block text-sm font-medium text-white/70"
              >Prompt body <span class="text-red-400">*</span></label
            >
            <textarea
              id="body"
              name="body"
              required
              maxlength="50000"
              rows={6}
              class="w-full rounded-md border border-white/20 bg-white/10 px-3 py-2 text-sm text-white placeholder-white/30 focus:border-purple-400 focus:outline-none"
              >{prompt.body}</textarea
            >
          </div>

          <div class="flex items-center gap-3">
            <button
              type="submit"
              class="rounded-md bg-purple-600 px-4 py-2 text-sm font-medium text-white transition-colors hover:bg-purple-500"
            >
              Save changes
            </button>
            <a href="/prompts" class="text-sm text-white/50 hover:text-white/80">Cancel</a>
          </div>
        </form>
      </div>
    </div>
  </div>
</Layout>
