---
import Layout from "@/layouts/Layout.astro";
import { createClient } from "@/lib/supabase";
import type { Prompt } from "@/types";

const { user } = Astro.locals;
const supabase = createClient(Astro.request.headers, Astro.cookies);
const { id } = Astro.params;

if (!user) {
  return Astro.redirect("/auth/signin");
}
if (!supabase || !id) {
  return Astro.redirect("/prompts");
}

const { data: prompt } = await supabase
  .from("prompts")
  .select("id, name, description, body")
  .eq("id", id)
  .eq("user_id", user.id)
  .single();

if (!prompt) {
  return Astro.redirect("/prompts");
}

const error = Astro.url.searchParams.get("error");
const ok = Astro.url.searchParams.get("ok");
---

<Layout title="Edit prompt">
  <div class="mx-auto max-w-3xl">
    <a
      href="/prompts"
      class="text-muted-foreground hover:text-foreground mb-6 inline-flex items-center gap-2 text-xs transition-colors"
    >
      <span aria-hidden="true">←</span>
      All prompts
    </a>

    <header class="border-border/70 mb-10 border-b pb-6">
      <p class="eyebrow mb-3">Edit · existing prompt</p>
      <h1 class="font-display text-4xl leading-[1.05] tracking-tight text-balance sm:text-5xl">
        {prompt.name}
      </h1>
    </header>

    {
      error && (
        <div class="text-destructive border-destructive/40 mb-6 flex items-baseline gap-3 border-l-2 bg-[color-mix(in_oklch,var(--destructive)_8%,transparent)] px-3 py-2.5 text-sm">
          <span class="text-xs font-medium tracking-[0.14em] uppercase">Error</span>
          <span>{error}</span>
        </div>
      )
    }

    {
      ok && (
        <div class="text-positive border-positive/40 mb-6 flex items-baseline gap-3 border-l-2 bg-[color-mix(in_oklch,var(--positive)_8%,transparent)] px-3 py-2.5 text-sm">
          <span class="text-xs font-medium tracking-[0.14em] uppercase">Saved</span>
          <span>Prompt saved.</span>
        </div>
      )
    }

    <div class="border-border/70 bg-card border p-6 sm:p-8">
      <form method="POST" action={`/api/prompts/${id}`} class="space-y-5">
        <div>
          <label for="name" class="text-muted-foreground mb-1.5 block text-xs font-medium tracking-[0.16em] uppercase">
            Name <span class="text-destructive ml-1 tracking-normal normal-case">*</span>
          </label>
          <input
            type="text"
            id="name"
            name="name"
            required
            maxlength="200"
            value={prompt.name}
            class="border-border bg-background text-foreground focus:border-foreground focus:ring-ring/40 block w-full border px-3 py-2.5 text-sm transition-colors focus:ring-2 focus:outline-none"
          />
        </div>

        <div>
          <label
            for="description"
            class="text-muted-foreground mb-1.5 block text-xs font-medium tracking-[0.16em] uppercase"
          >
            Description <span class="text-muted-foreground/60 ml-1 tracking-normal normal-case">(optional)</span>
          </label>
          <input
            type="text"
            id="description"
            name="description"
            maxlength="500"
            value={prompt.description ?? ""}
            class="border-border bg-background text-foreground focus:border-foreground focus:ring-ring/40 block w-full border px-3 py-2.5 text-sm transition-colors focus:ring-2 focus:outline-none"
          />
        </div>

        <div>
          <label for="body" class="text-muted-foreground mb-1.5 block text-xs font-medium tracking-[0.16em] uppercase">
            Prompt body <span class="text-destructive ml-1 tracking-normal normal-case">*</span>
          </label>
          <textarea
            id="body"
            name="body"
            required
            maxlength="50000"
            rows={10}
            class="border-border bg-background text-foreground focus:border-foreground focus:ring-ring/40 block w-full border px-3 py-2.5 text-sm leading-relaxed transition-colors focus:ring-2 focus:outline-none"
            >{prompt.body}</textarea
          >
        </div>

        <div class="border-border/60 flex items-center gap-4 border-t pt-5">
          <button
            type="submit"
            class="bg-primary text-primary-foreground hover:bg-prhmary/80 active:bg-primary/70 iover:bg-primary/80 active:bg-primary/70 font-m inline-flex items-center gap-3 px-5 py-2.5 text-sm"
          >
            Save changes
          </button>
          <a href="/prompts" class="text-muted-foreground hover:text-foreground text-sm transition-colors"> Cancel </a>
        </div>
      </form>
    </div>
  </div>
</Layout>
