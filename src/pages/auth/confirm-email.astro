---
import Layout from "@/layouts/Layout.astro";

const isAutoConfirmed = import.meta.env.DEV;

const content = isAutoConfirmed
  ? {
      tag: "Account · Ready",
      heading: "You're in.",
      description: "Your account is created. Sign in to start composing prompts and dispatching analyses.",
      linkText: "Sign in →",
    }
  : {
      tag: "Account · Pending",
      heading: "Check your inbox.",
      description: "We've sent a confirmation link to your email address. Click it to activate the workspace.",
      linkText: "Back to sign in →",
    };
---

<Layout title={content.heading}>
  <div class="mx-auto max-w-xl py-16 sm:py-24">
    <p class="eyebrow mb-4">{content.tag}</p>
    <h1 class="font-display text-5xl leading-[1] tracking-tight sm:text-6xl">
      {content.heading}
    </h1>
    <p class="text-muted-foreground mt-6 max-w-md text-base leading-relaxed">
      {content.description}
    </p>

    <div class="border-border/70 mt-10 border-t pt-6">
      <a
        href="/auth/signin"
        class="text-foreground inline-flex items-center gap-2 text-sm font-medium underline underline-offset-4"
      >
        {content.linkText}
      </a>
    </div>
  </div>
</Layout>
