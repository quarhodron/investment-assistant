---
import Layout from "@/layouts/Layout.astro";
import NewAnalysisForm from "@/components/NewAnalysisForm";
import { createClient } from "@/lib/supabase";
import type { Prompt, AiModel } from "@/types";

const { user } = Astro.locals;
const supabase = createClient(Astro.request.headers, Astro.cookies);

type ApiKeysShape = { anthropic?: unknown; openai?: unknown } | null;

let prompts: Pick<Prompt, "id" | "name" | "description" | "body">[] = [];
let models: AiModel[] = [];
let apiKeyStatus = { anthropic: false, openai: false };
let defaultModelId: string | null = null;

if (supabase && user) {
  const [promptsResult, modelsResult, settingsResult] = await Promise.all([
    supabase.from("prompts").select("id, name, description, body").eq("user_id", user.id).order("name"),
    supabase
      .from("ai_models")
      .select("id, provider, display_name, is_default, sort_order, enabled, supports_web_search, created_at")
      .eq("enabled", true)
      .order("sort_order"),
    supabase.from("user_settings").select("default_model, api_keys").eq("user_id", user.id).single(),
  ]);

  if (promptsResult.data) {
    prompts = promptsResult.data;
  }

  if (modelsResult.data) {
    models = modelsResult.data;
  }

  if (settingsResult.data) {
    const keys = settingsResult.data.api_keys as ApiKeysShape;
    apiKeyStatus = {
      anthropic: keys?.anthropic !== undefined,
      openai: keys?.openai !== undefined,
    };
    defaultModelId = settingsResult.data.default_model ?? null;
  }
}
---

<Layout title="New analysis">
  <div class="mx-auto max-w-3xl">
    <header class="border-border/70 mb-10 border-b pb-6">
      <p class="eyebrow mb-3">Dispatch · new run</p>
      <h1 class="font-display text-5xl leading-[1.05] tracking-tight sm:text-6xl">
        New <span class="font-light italic">analysis</span>
      </h1>
      <p class="text-muted-foreground mt-3 text-sm">
        Pick a prompt and a model, supply the subject, and dispatch the research run.
      </p>
    </header>

    <NewAnalysisForm
      prompts={prompts}
      models={models}
      apiKeyStatus={apiKeyStatus}
      defaultModelId={defaultModelId}
      client:load
    />
  </div>
</Layout>
