---
import Layout from "@/layouts/Layout.astro";
import { createClient } from "@/lib/supabase";
import { buildAnalysisForest } from "@/lib/analyses-tree";
import type { AnalysisRow } from "@/lib/analyses-tree";
import AnalysisTreeNodeComponent from "@/components/AnalysisTreeNode.astro";

const { user } = Astro.locals;
const supabase = createClient(Astro.request.headers, Astro.cookies);

let analyses: AnalysisRow[] = [];

if (supabase && user) {
  const { data } = await supabase
    .from("analyses")
    .select("id, title, model, provider, created_at, parent_analysis_id")
    .eq("user_id", user.id);

  if (data) {
    analyses = data;
  }
}

const roots = buildAnalysisForest(analyses);
---

<Layout title="Research">
  <header class="border-border/70 mb-10 flex flex-wrap items-end justify-between gap-6 border-b pb-6">
    <div>
      <p class="eyebrow mb-2">All research · <span class="num">{analyses.length} runs</span></p>
      <h1 class="font-display text-5xl tracking-tight">
        Research <span class="font-light italic">archive</span>
      </h1>
    </div>
    <a
      href="/analyses/new"
      class="bg-primary text-primary-foreground hover:bg-primary/80 active:bg-primary/70 inline-flex items-center gap-2 px-4 py-2.5 text-xs font-medium tracking-[0.08em] transition-colors"
    >
      + New analysis
    </a>
  </header>

  {
    analyses.length === 0 ? (
      <div class="border-border/70 bg-card flex flex-col items-start gap-3 border p-10">
        <p class="eyebrow">Empty archive</p>
        <p class="font-display text-3xl tracking-tight">
          Nothing on file — <span class="font-light italic">run your first analysis.</span>
        </p>
        <p class="text-muted-foreground max-w-md text-sm">
          Saved runs appear here as a tree. Continue any run to branch a new thread under it.
        </p>
        <a
          href="/analyses/new"
          class="bg-primary text-primary-foreground hover:bg-primary/80 mt-3 inline-flex items-center gap-2 px-4 py-2 text-xs font-medium tracking-[0.08em] transition-colors"
        >
          New analysis →
        </a>
      </div>
    ) : (
      <div class="border-border/70 divide-border/70 divide-y border-y">
        {roots.map((root) => (
          <AnalysisTreeNodeComponent node={root} depth={0} />
        ))}
      </div>
    )
  }
</Layout>
