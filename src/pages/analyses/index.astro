---
import Layout from "@/layouts/Layout.astro";
import { createClient } from "@/lib/supabase";
import { buildAnalysisForest } from "@/lib/analyses-tree";
import type { AnalysisRow } from "@/lib/analyses-tree";
import AnalysisTreeNodeComponent from "@/components/AnalysisTreeNode.astro";

const { user } = Astro.locals;
const supabase = createClient(Astro.request.headers, Astro.cookies);

let analyses: AnalysisRow[] = [];

if (supabase && user) {
  const { data } = await supabase
    .from("analyses")
    .select("id, title, model, provider, created_at, parent_analysis_id")
    .eq("user_id", user.id);

  if (data) {
    analyses = data;
  }
}

const roots = buildAnalysisForest(analyses);
---

<Layout title="Analyses">
  <div class="bg-cosmic min-h-screen p-6">
    <div class="mx-auto max-w-3xl">
      <h1 class="mb-6 bg-gradient-to-r from-blue-200 to-purple-200 bg-clip-text text-2xl font-bold text-transparent">
        Analyses
      </h1>

      {
        analyses.length === 0 ? (
          <div class="rounded-lg border border-white/10 bg-white/5 p-8 text-center">
            <p class="mb-4 text-slate-300">No analyses yet — run your first one.</p>
            <a
              href="/analyses/new"
              class="inline-block rounded-md bg-purple-600 px-4 py-2 text-sm font-medium text-white transition-colors hover:bg-purple-500"
            >
              New Analysis
            </a>
          </div>
        ) : (
          <div class="space-y-3">
            {roots.map((root) => (
              <AnalysisTreeNodeComponent node={root} depth={0} />
            ))}
          </div>
        )
      }
    </div>
  </div>
</Layout>
