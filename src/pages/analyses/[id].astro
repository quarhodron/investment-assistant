---
import Layout from "@/layouts/Layout.astro";
import Banner from "@/components/Banner.astro";
import MarkdownOutput from "@/components/MarkdownOutput";
import { createClient } from "@/lib/supabase";
import { flattenSources } from "@/lib/sources";
import type { Analysis, StoredSources } from "@/types";

const { user } = Astro.locals;
const supabase = createClient(Astro.request.headers, Astro.cookies);
const { id } = Astro.params;

if (!supabase || !user || !id) {
  return Astro.redirect("/analyses");
}

const { data, error } = await supabase
  .from("analyses")
  .select("*")
  .eq("id", id)
  .eq("user_id", user.id)
  .single();

if (error || !data) {
  return Astro.redirect("/analyses");
}

const analysis = data as Analysis;
const sources = flattenSources(analysis.sources as StoredSources | null);
const createdAt = new Date(analysis.created_at).toLocaleString();
---

<Layout title={analysis.title}>
  <Banner variant="info">
    This analysis is for informational purposes only and does not constitute investment advice.
  </Banner>

  <div class="bg-cosmic min-h-screen p-6">
    <div class="mx-auto max-w-3xl">
      <div class="mb-6">
        <div class="mb-2 flex flex-wrap items-center gap-2">
          <span class="rounded-full bg-purple-500/20 px-2.5 py-0.5 text-xs text-purple-300">
            {analysis.analysis_type}
          </span>
          <span class="rounded-full bg-slate-500/20 px-2.5 py-0.5 text-xs text-slate-300">
            {analysis.provider} / {analysis.model}
          </span>
          <span class="text-xs text-slate-400">{createdAt}</span>
        </div>
        <h1 class="bg-gradient-to-r from-blue-200 to-purple-200 bg-clip-text text-2xl font-bold text-transparent">
          {analysis.title}
        </h1>
      </div>

      <section class="mb-6 rounded-lg border border-white/10 bg-white/5 p-4">
        <h2 class="mb-2 text-xs font-semibold uppercase tracking-wide text-slate-400">Input</h2>
        <p class="whitespace-pre-wrap text-sm text-slate-200">{analysis.input}</p>
        {
          analysis.extra_context && (
            <div class="mt-3">
              <h3 class="mb-1 text-xs font-semibold uppercase tracking-wide text-slate-400">Extra Context</h3>
              <p class="whitespace-pre-wrap text-sm text-slate-200">{analysis.extra_context}</p>
            </div>
          )
        }
      </section>

      <details class="mb-6 rounded-lg border border-white/10 bg-white/5">
        <summary class="cursor-pointer p-4 text-xs font-semibold uppercase tracking-wide text-slate-400 hover:text-slate-200">
          Prompt Used
        </summary>
        <div class="border-t border-white/10 p-4">
          <p class="mb-1 text-sm font-medium text-white">{analysis.prompt_name_snapshot}</p>
          {
            analysis.prompt_description_snapshot && (
              <p class="mb-2 text-xs text-slate-400">{analysis.prompt_description_snapshot}</p>
            )
          }
          <pre class="overflow-x-auto whitespace-pre-wrap rounded bg-black/20 p-3 text-xs text-slate-300">{analysis.prompt_body_snapshot}</pre>
        </div>
      </details>

      <section class="mb-6 rounded-lg border border-white/10 bg-white/5 p-4">
        <h2 class="mb-3 text-xs font-semibold uppercase tracking-wide text-slate-400">AI Output</h2>
        <MarkdownOutput content={analysis.output} client:load />
      </section>

      <details class="mb-6 rounded-lg border border-white/10 bg-white/5">
        <summary class="cursor-pointer p-4 text-xs font-semibold uppercase tracking-wide text-slate-400 hover:text-slate-200">
          Sources
        </summary>
        <div class="border-t border-white/10 p-4">
          {
            sources.length === 0 ? (
              <p class="text-sm text-slate-400">No sources returned.</p>
            ) : (
              <ol class="list-decimal space-y-1.5 pl-5">
                {sources.map((s) => (
                  <li class="text-sm">
                    <a
                      href={s.url}
                      target="_blank"
                      rel="noopener noreferrer"
                      class="text-blue-300 underline hover:text-blue-200"
                    >
                      {s.title ?? s.url}
                    </a>
                  </li>
                ))}
              </ol>
            )
          }
        </div>
      </details>
    </div>
  </div>
</Layout>
