---
import Layout from "@/layouts/Layout.astro";
import Banner from "@/components/Banner.astro";
import MarkdownOutput from "@/components/MarkdownOutput";
import { createClient } from "@/lib/supabase";
import { flattenSources } from "@/lib/sources";
import type { Analysis, StoredSources } from "@/types";

const { user } = Astro.locals;
const supabase = createClient(Astro.request.headers, Astro.cookies);
const { id } = Astro.params;

if (!supabase || !user || !id) {
  return Astro.redirect("/analyses");
}

const { data, error } = await supabase.from("analyses").select("*").eq("id", id).eq("user_id", user.id).single();

if (error || !data) {
  return Astro.redirect("/analyses");
}

const analysis = data as Analysis;
const sources = flattenSources(analysis.sources as StoredSources | null);
const createdAt = new Date(analysis.created_at).toLocaleString("pl-PL");

const [parentAnalysis, { data: childrenData }] = await Promise.all([
  analysis.parent_analysis_id
    ? supabase
        .from("analyses")
        .select("id, title")
        .eq("id", analysis.parent_analysis_id)
        .eq("user_id", user.id)
        .single()
        .then(({ data }) => data)
    : Promise.resolve(null),
  supabase
    .from("analyses")
    .select("id, title, created_at")
    .eq("parent_analysis_id", analysis.id)
    .eq("user_id", user.id)
    .order("created_at", { ascending: true }),
]);

const children = childrenData ?? [];
---

<Layout title={analysis.title}>
  <Banner variant="info"> For informational use only — not investment advice. Verify before acting. </Banner>

  <article class="mx-auto max-w-5xl">
    <!-- Lineage breadcrumb -->
    {
      parentAnalysis && (
        <p class="mb-6">
          <a
            href={`/analyses/${parentAnalysis.id}`}
            class="text-muted-foreground hover:text-foreground inline-flex items-center gap-2 text-xs transition-colors"
          >
            <span aria-hidden="true">←</span>
            <span class="eyebrow !text-current">Continued from</span>
            <span class="text-foreground font-medium">{parentAnalysis.title}</span>
          </a>
        </p>
      )
    }

    <!-- Masthead -->
    <header class="border-border/70 grid gap-8 border-b pb-10 lg:grid-cols-12 lg:gap-12">
      <div class="lg:col-span-8">
        <p class="eyebrow mb-4">
          <span class="num">{analysis.provider}</span> · <span class="num">{analysis.model}</span> · <time
            class="num"
            datetime={analysis.created_at}>{createdAt}</time
          >
        </p>
        <h1 class="font-display text-4xl leading-[1.05] tracking-tight text-balance sm:text-5xl lg:text-[3.25rem]">
          {analysis.title}
        </h1>
        <div class="mt-8">
          <a
            href={`/analyses/${analysis.id}/continue`}
            class="bg-primary text-primary-foreground group hover:bg-primary/80 active:bg-primary/70 inline-flex items-center gap-3 px-5 py-3 text-sm font-medium tracking-[0.08em] transition-colors"
          >
            Continue analysis →
          </a>
        </div>
      </div>

      <!-- Sidebar: continuations + meta -->
      <aside class="border-border/70 lg:col-span-4 lg:border-l lg:pl-8">
        {
          children.length > 0 ? (
            <>
              <p class="eyebrow mb-3">Continued as</p>
              <ul class="border-border/60 divide-border/60 divide-y border-y">
                {children.map((child) => (
                  <li>
                    <a
                      href={`/analyses/${child.id}`}
                      class="group flex items-baseline justify-between gap-3 py-2.5 text-sm transition-colors hover:bg-[color-mix(in_oklch,var(--foreground)_3%,transparent)]"
                    >
                      <span class="group-hover:text-foreground line-clamp-2 font-medium">{child.title}</span>
                      <span class="num text-muted-foreground shrink-0 text-[0.6875rem]">
                        {new Date(child.created_at).toLocaleDateString("en-GB", {
                          day: "2-digit",
                          month: "short",
                        })}
                      </span>
                    </a>
                  </li>
                ))}
              </ul>
            </>
          ) : (
            <>
              <p class="eyebrow mb-3">Thread</p>
              <p class="text-muted-foreground text-sm">
                This is a leaf analysis.{" "}
                <a href={`/analyses/${analysis.id}/continue`} class="text-foreground underline underline-offset-2">
                  Branch a continuation
                </a>{" "}
                to extend the thread.
              </p>
            </>
          )
        }
      </aside>
    </header>

    <!-- Two-column body: topic + prompt rail on the left, output on the right -->
    <section class="mt-10 grid gap-10 lg:grid-cols-12 lg:gap-12">
      <!-- Left rail: topic, prompt, sources -->
      <aside class="space-y-8 lg:col-span-4">
        <div>
          <p class="eyebrow mb-2">Topic</p>
          <p class="text-foreground/90 text-sm whitespace-pre-wrap">{analysis.input}</p>
          {
            analysis.extra_context && (
              <div class="mt-4">
                <p class="eyebrow mb-2">Extra context</p>
                <p class="text-foreground/90 text-sm whitespace-pre-wrap">{analysis.extra_context}</p>
              </div>
            )
          }
        </div>

        <details class="border-border/70 group border-t pt-4">
          <summary
            class="eyebrow hover:text-foreground flex cursor-pointer list-none items-center justify-between [&::-webkit-details-marker]:hidden"
          >
            <span>Prompt used</span>
            <span class="text-foreground/60 ml-2 text-base transition-transform group-open:rotate-45">+</span>
          </summary>
          <div class="mt-4">
            <p class="text-sm font-medium">{analysis.prompt_name_snapshot}</p>
            {
              analysis.prompt_description_snapshot && (
                <p class="text-muted-foreground mt-1 text-xs">{analysis.prompt_description_snapshot}</p>
              )
            }
            <pre
              class="num text-foreground/80 bg-muted/60 mt-3 overflow-x-auto p-3 text-[0.75rem] leading-relaxed whitespace-pre-wrap">{analysis.prompt_body_snapshot}</pre>
          </div>
        </details>

        <details class="border-border/70 group border-t pt-4">
          <summary
            class="eyebrow hover:text-foreground flex cursor-pointer list-none items-center justify-between [&::-webkit-details-marker]:hidden"
          >
            <span>Sources · <span class="num">{sources.length}</span></span>
            <span class="text-foreground/60 ml-2 text-base transition-transform group-open:rotate-45">+</span>
          </summary>
          <div class="mt-4">
            {
              sources.length === 0 ? (
                <p class="text-muted-foreground text-sm">No sources returned.</p>
              ) : (
                <ol class="space-y-2 text-sm">
                  {sources.map((s, i) => (
                    <li class="flex gap-2">
                      <span class="num text-muted-foreground shrink-0 text-xs">{String(i + 1).padStart(2, "0")}</span>
                      <a
                        href={s.url}
                        target="_blank"
                        rel="noopener noreferrer"
                        class="text-foreground line-clamp-2 underline-offset-2 hover:underline"
                      >
                        {s.title ?? s.url}
                      </a>
                    </li>
                  ))}
                </ol>
              )
            }
          </div>
        </details>
      </aside>

      <!-- Output -->
      <section class="lg:col-span-8">
        <p class="eyebrow mb-3">Analysis</p>
        <div class="border-border/70 border-t pt-6">
          <MarkdownOutput content={analysis.output} client:load />
        </div>
      </section>
    </section>
  </article>
</Layout>
