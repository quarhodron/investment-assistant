---
import Layout from "@/layouts/Layout.astro";
import { createClient } from "@/lib/supabase";
import type { Prompt } from "@/types";

const { user } = Astro.locals;
const supabase = createClient(Astro.request.headers, Astro.cookies);

const error = Astro.url.searchParams.get("error");
const ok = Astro.url.searchParams.get("ok");

let prompts: Pick<Prompt, "id" | "name" | "description" | "created_at">[] = [];

if (supabase && user) {
  const { data } = await supabase
    .from("prompts")
    .select("id, name, description, created_at")
    .eq("user_id", user.id)
    .order("name");
  if (data) {
    prompts = data;
  }
}
---

<Layout title="Prompts">
  <header class="border-border/70 mb-10 flex flex-wrap items-end justify-between gap-6 border-b pb-6">
    <div>
      <p class="eyebrow mb-2">Library · <span class="num">{prompts.length} prompts</span></p>
      <h1 class="font-display text-5xl tracking-tight">
        Prompts <span class="font-light italic">library</span>
      </h1>
    </div>
    <p class="text-muted-foreground max-w-xs text-xs leading-relaxed">
      Reusable instructions that scaffold each analysis. Compose once, dispatch many.
    </p>
  </header>

  {
    error && (
      <div class="text-destructive border-destructive/40 mb-6 flex items-baseline gap-3 border-l-2 bg-[color-mix(in_oklch,var(--destructive)_8%,transparent)] px-3 py-2.5 text-sm">
        <span class="text-[0.625rem] font-medium tracking-[0.14em] uppercase">Error</span>
        <span>{error}</span>
      </div>
    )
  }

  {
    ok === "1" && (
      <div class="text-positive border-positive/40 mb-6 flex items-baseline gap-3 border-l-2 bg-[color-mix(in_oklch,var(--positive)_8%,transparent)] px-3 py-2.5 text-sm">
        <span class="text-[0.625rem] font-medium tracking-[0.14em] uppercase">Saved</span>
        <span>Prompt created successfully.</span>
      </div>
    )
  }

  {
    ok === "deleted" && (
      <div class="text-muted-foreground border-foreground/30 mb-6 flex items-baseline gap-3 border-l-2 bg-[color-mix(in_oklch,var(--foreground)_4%,transparent)] px-3 py-2.5 text-sm">
        <span class="text-[0.625rem] font-medium tracking-[0.14em] uppercase">Removed</span>
        <span>Prompt deleted.</span>
      </div>
    )
  }

  <section class="grid gap-12">
    <!-- Create form -->
    <aside class="border-border/70">
      <h2 class="font-display mb-4 text-2xl tracking-tight">Compose</h2>
      <div class="border-border/70 bg-card border p-6">
        <form method="POST" action="/api/prompts" class="space-y-5">
          <div>
            <label
              for="name"
              class="text-muted-foreground mb-1.5 block text-[0.6875rem] font-medium tracking-[0.16em] uppercase"
            >
              Name <span class="text-destructive ml-1 tracking-normal normal-case">*</span>
            </label>
            <input
              type="text"
              id="name"
              name="name"
              required
              maxlength="200"
              placeholder="e.g. Sector overview"
              class="border-border bg-background text-foreground placeholder:text-muted-foreground/60 focus:border-foreground focus:ring-ring/40 block w-full border px-3 py-2.5 text-sm transition-colors focus:ring-2 focus:outline-none"
            />
          </div>

          <div>
            <label
              for="description"
              class="text-muted-foreground mb-1.5 block text-[0.6875rem] font-medium tracking-[0.16em] uppercase"
            >
              Description <span class="text-muted-foreground/60 ml-1 tracking-normal normal-case">(optional)</span>
            </label>
            <input
              type="text"
              id="description"
              name="description"
              maxlength="500"
              placeholder="When to use this prompt"
              class="border-border bg-background text-foreground placeholder:text-muted-foreground/60 focus:border-foreground focus:ring-ring/40 block w-full border px-3 py-2.5 text-sm transition-colors focus:ring-2 focus:outline-none"
            />
          </div>

          <div>
            <label
              for="body"
              class="text-muted-foreground mb-1.5 block text-[0.6875rem] font-medium tracking-[0.16em] uppercase"
            >
              Prompt body <span class="text-destructive ml-1 tracking-normal normal-case">*</span>
            </label>
            <textarea
              id="body"
              name="body"
              required
              maxlength="50000"
              rows={8}
              placeholder="The full prompt text. The user's topic will be appended."
              class="border-border bg-background text-foreground placeholder:text-muted-foreground/60 focus:border-foreground focus:ring-ring/40 block w-full border px-3 py-2.5 text-sm leading-relaxed transition-colors focus:ring-2 focus:outline-none"
            ></textarea>
          </div>

          <button
            type="submit"
            class="bg-primary text-primary-foreground hover:bg-primary/80 active:bg-primary/70 inline-flex items-center gap-3 px-5 py-2.5 text-sm font-medium tracking-[0.08em] transition-colors"
          >
            Create prompt
          </button>
        </form>
      </div>
    </aside>

    <!-- Existing prompts -->
    <div>
      <h2 class="font-display mb-4 text-2xl tracking-tight">Saved</h2>
      {
        prompts.length === 0 ? (
          <div class="border-border/70 bg-card flex flex-col items-start gap-2 border p-6">
            <p class="eyebrow">Empty</p>
            <p class="font-display text-xl tracking-tight">No prompts yet.</p>
            <p class="text-muted-foreground text-sm">Create your first one in the panel to the left.</p>
          </div>
        ) : (
          <ul class="border-border/70 divide-border/70 divide-y border-y">
            {prompts.map((prompt) => (
              <li class="group/row flex items-start justify-between gap-4 py-4" data-prompt-row>
                <div class="min-w-0 flex-1">
                  <p class="text-foreground text-base font-medium">{prompt.name}</p>
                  {prompt.description && <p class="text-muted-foreground mt-1 text-sm">{prompt.description}</p>}
                  <p class="num text-muted-foreground/80 mt-1.5 text-[0.6875rem]">
                    Created{" "}
                    {new Date(prompt.created_at).toLocaleDateString("en-GB", {
                      day: "2-digit",
                      month: "short",
                      year: "numeric",
                    })}
                  </p>
                </div>
                <div class="flex shrink-0 items-center gap-4 pt-1">
                  <a
                    href={`/prompts/${prompt.id}/edit`}
                    class="text-muted-foreground hover:text-foreground text-xs underline-offset-2 hover:underline"
                  >
                    Edit
                  </a>
                  <div data-delete-initial>
                    <button
                      type="button"
                      data-confirm-delete
                      class="text-destructive/80 hover:text-destructive text-xs underline-offset-2 hover:underline"
                    >
                      Delete
                    </button>
                  </div>
                  <div data-delete-confirm hidden>
                    <form method="POST" action={`/api/prompts/${prompt.id}`} class="flex items-center gap-3">
                      <input type="hidden" name="action" value="delete" />
                      <button
                        type="submit"
                        class="text-destructive border-destructive/60 hover:bg-destructive hover:text-background border-x px-2 py-1 text-xs font-medium transition-colors"
                      >
                        Confirm delete
                      </button>
                      <button
                        type="button"
                        data-delete-cancel
                        class="text-muted-foreground hover:text-foreground text-xs"
                      >
                        Cancel
                      </button>
                    </form>
                  </div>
                </div>
              </li>
            ))}
          </ul>
        )
      }
    </div>
  </section>
  <script>
    document.querySelectorAll("[data-prompt-row]").forEach((row) => {
      const initial = row.querySelector("[data-delete-initial]");
      const confirm = row.querySelector("[data-delete-confirm]");
      row.querySelector("[data-confirm-delete]")?.addEventListener("click", () => {
        initial?.setAttribute("hidden", "");
        confirm?.removeAttribute("hidden");
      });
      row.querySelector("[data-delete-cancel]")?.addEventListener("click", () => {
        confirm?.setAttribute("hidden", "");
        initial?.removeAttribute("hidden");
      });
    });
  </script>
</Layout>
