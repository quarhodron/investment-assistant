---
import Layout from "@/layouts/Layout.astro";
import SettingsForm from "@/components/SettingsForm";
import { createClient } from "@/lib/supabase";
import type { AiModel } from "@/types";

const { user } = Astro.locals;
const supabase = createClient(Astro.request.headers, Astro.cookies);

const error = Astro.url.searchParams.get("error");
const ok = Astro.url.searchParams.get("ok");

type ApiKeysShape = { anthropic?: unknown; openai?: unknown } | null;

let apiKeyStatus = { anthropic: { configured: false }, openai: { configured: false } };
let models: AiModel[] = [];
let defaultModelId: string | null = null;

if (supabase && user) {
  const [settingsResult, modelsResult] = await Promise.all([
    supabase.from("user_settings").select("default_model, api_keys").eq("user_id", user.id).single(),
    supabase
      .from("ai_models")
      .select("id, provider, display_name, is_default, sort_order, enabled, supports_web_search, created_at")
      .eq("enabled", true)
      .order("sort_order"),
  ]);

  if (settingsResult.data) {
    const keys = settingsResult.data.api_keys as ApiKeysShape;
    apiKeyStatus = {
      anthropic: { configured: keys?.anthropic !== undefined },
      openai: { configured: keys?.openai !== undefined },
    };
    defaultModelId = settingsResult.data.default_model ?? null;
  }

  if (modelsResult.data) {
    models = modelsResult.data;
  }
}
---

<Layout title="Settings">
  <div class="mx-auto max-w-4xl">
    <header class="border-border/70 mb-10 border-b pb-6">
      <p class="eyebrow mb-2">Workspace · configuration</p>
      <h1 class="font-display text-5xl tracking-tight">Settings</h1>
      <p class="text-muted-foreground mt-3 max-w-xl text-sm">
        Bring your own model keys and pick a default. Keys are encrypted at rest; you can replace or remove them any
        time.
      </p>
    </header>

    {
      error && (
        <div class="text-destructive border-destructive/40 mb-6 flex items-baseline gap-3 border-l-2 bg-[color-mix(in_oklch,var(--destructive)_8%,transparent)] px-3 py-2.5 text-sm">
          <span class="text-xs font-medium tracking-[0.14em] uppercase">Error</span>
          <span>{decodeURIComponent(error)}</span>
        </div>
      )
    }

    {
      ok && (
        <div class="text-positive border-positive/40 mb-6 flex items-baseline gap-3 border-l-2 bg-[color-mix(in_oklch,var(--positive)_8%,transparent)] px-3 py-2.5 text-sm">
          <span class="text-xs font-medium tracking-[0.14em] uppercase">Saved</span>
          <span>Settings saved successfully.</span>
        </div>
      )
    }

    <SettingsForm status={apiKeyStatus} models={models} defaultModelId={defaultModelId} client:load />
  </div>
</Layout>
